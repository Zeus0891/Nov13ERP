model Estimate {
  // 🆔 Identity / Tenancy / Global linkage (Hybrid parent)
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  /// Shared global UUID for 1:1:1 Estimate → Project → Invoice
  /// NOT A FOREIGN KEY — hybrid linkage only
  globalId String @db.Uuid

  // 📄 Business identity
  /// Non-editable document number (generated via NumberSequence module)
  estimateNumber String  @db.VarChar(50)
  /// Short title shown in list/detail views
  title          String  @db.VarChar(255)
  referenceCode  String? @db.VarChar(100)
  description    String? @db.Text

  // 👥 Customer / CRM linkage
  crmAccountId    String  @db.Uuid
  crmContactId    String? @db.Uuid
  billToAddressId String? @db.Uuid
  shipToAddressId String? @db.Uuid

  // 👤 Ownership
  ownerMemberId String? @db.Uuid

  // 🔗 Project linkage (optional if created from existing project)
  linkedProjectId String? @db.Uuid

  // 📆 Lifecycle & workflow state
  status         EstimateStatus         @default(DRAFT)
  approvalStatus EstimateApprovalStatus @default(NOT_REQUIRED)
  clientStatus   EstimateClientStatus   @default(PENDING)

  issueDate         DateTime  @default(now()) @db.Timestamptz(6)
  validUntil        DateTime? @db.Timestamptz(6)
  sentAt            DateTime? @db.Timestamptz(6)
  clientViewedAt    DateTime? @db.Timestamptz(6)
  clientRespondedAt DateTime? @db.Timestamptz(6)
  acceptedAt        DateTime? @db.Timestamptz(6)
  declinedAt        DateTime? @db.Timestamptz(6)
  expiredAt         DateTime? @db.Timestamptz(6)
  convertedAt       DateTime? @db.Timestamptz(6)

  // 💰 Financial snapshot
  currencyCode   String  @db.Char(3)
  subtotalAmount Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  feeAmount      Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @default(0) @db.Decimal(12, 2)
  totalQuantity  Decimal @default(0) @db.Decimal(10, 4)
  lineItemCount  Int     @default(0)

  // ⚙️ Behaviour flags
  autoCreateProjectOnApproval Boolean @default(true)
  autoCreateInvoiceOnApproval Boolean @default(true)
  allowChangeOrders           Boolean @default(true)
  isTemplate                  Boolean @default(false)
  isArchived                  Boolean @default(false)

  // 📊 Lifecycle
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  // 👤 Actor audit
  createdByActorId String? @db.Uuid
  updatedByActorId String? @db.Uuid
  deletedByActorId String? @db.Uuid

  // 🧠 Governance
  auditCorrelationId String?                    @db.Uuid
  dataClassification EstimateDataClassification @default(CONFIDENTIAL)

  // 🔗 External module FKs
  approvalRequestId          String? @db.Uuid
  eSignatureEnvelopeId       String? @db.Uuid
  numberSequenceAllocationId String? @db.Uuid

  // 🧩 Relations — tenancy (parent)
  tenant Tenant @relation("TenantToEstimate", fields: [tenantId], references: [id], onDelete: Restrict)

  // 👤 Actor relations
  createdByActor Actor? @relation("EstimateCreatedByActor", fields: [createdByActorId], references: [id], onDelete: SetNull)
  updatedByActor Actor? @relation("EstimateUpdatedByActor", fields: [updatedByActorId], references: [id], onDelete: SetNull)
  deletedByActor Actor? @relation("EstimateDeletedByActor", fields: [deletedByActorId], references: [id], onDelete: SetNull)

  // 👥 CRM relations
  crmAccount    CRMAccount  @relation(fields: [tenantId, crmAccountId], references: [tenantId, id], onDelete: Restrict)
  crmContact    CRMContact? @relation(fields: [tenantId, crmContactId], references: [tenantId, id], onDelete: SetNull)
  billToAddress CRMAddress? @relation("EstimateBillToAddress", fields: [tenantId, billToAddressId], references: [tenantId, id], onDelete: SetNull)
  shipToAddress CRMAddress? @relation("EstimateShipToAddress", fields: [tenantId, shipToAddressId], references: [tenantId, id], onDelete: SetNull)

  // 👤 Owner
  ownerMember Member? @relation(fields: [tenantId, ownerMemberId], references: [tenantId, id], onDelete: SetNull)

  // 🟦 Related modules
  approvalRequest          ApprovalRequest?          @relation(fields: [tenantId, approvalRequestId], references: [tenantId, id], onDelete: SetNull)
  eSignatureEnvelope       ESignatureEnvelope?       @relation(fields: [tenantId, eSignatureEnvelopeId], references: [tenantId, id], onDelete: SetNull)
  numberSequenceAllocation NumberSequenceAllocation? @relation(fields: [numberSequenceAllocationId], references: [id], onDelete: SetNull)

  // 📦 Estimate module children
  revisions     EstimateRevision[]
  sections      EstimateSection[]
  lineItems     EstimateLineItem[]
  taxes         EstimateTax[]
  discounts     EstimateDiscount[]
  fees          EstimateFee[]
  terms         EstimateTerm[]
  assumptions   EstimateAssumption[]
  exclusions    EstimateExclusion[]
  alternates    EstimateAlternate[]
  attachments   EstimateAttachment[]
  comments      EstimateComment[]
  comparisons   EstimateComparison[]
  historyEvents EstimateHistoryEvent[]
  publicLinks   EstimatePublicLink[]

  // 🌉 Cross-module relations (foreign keys live in other modules)
  projects     Project[]     @relation("EstimateToProjects")
  invoices     Invoice[]     @relation("EstimateToInvoices")
  changeOrders ChangeOrder[] @relation("EstimateToChangeOrders")

  // 🗂️ Indexes & constraints
  @@unique([tenantId, globalId])
  @@unique([tenantId, estimateNumber])
  @@index([globalId])
  @@index([tenantId, status])
  @@index([tenantId, approvalStatus])
  @@index([tenantId, clientStatus])
  @@index([tenantId, crmAccountId])
  @@index([tenantId, ownerMemberId])
  @@index([tenantId, linkedProjectId])
  @@index([tenantId, deletedAt])
  @@index([createdAt], type: Brin)
  @@index([tenantId, auditCorrelationId])
  @@index([tenantId, dataClassification])
  @@index([tenantId, crmContactId])
  @@index([tenantId, billToAddressId])
  @@index([tenantId, shipToAddressId])
  @@index([tenantId, approvalRequestId])
  @@index([tenantId, eSignatureEnvelopeId])
  @@map("estimate")
}

model EstimateRevision {
  // 🆔 Identity & Tenant
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  // 🔗 Parent estimate relationship
  estimateId String @db.Uuid

  // 📄 Revision details
  /// Revision number (1, 2, 3, etc.)
  revisionNumber Int                  @db.Integer
  /// Brief description of changes made in this revision
  revisionNotes  String?              @db.Text
  /// Snapshot of estimate data at the time of revision
  snapshot       Json                 @db.JsonB
  /// Is this the current active revision?
  isActive       Boolean              @default(false)
  /// Revision type: INITIAL, CHANGE_REQUEST, PRICE_UPDATE, SCOPE_CHANGE
  revisionType   EstimateRevisionType @default(CHANGE_REQUEST)

  // 💰 Financial snapshot (frozen at revision time)
  subtotalAmount Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  feeAmount      Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @default(0) @db.Decimal(12, 2)

  // 📊 Lifecycle
  status    EstimateEntityStatus @default(ACTIVE)
  version   Int                  @default(1)
  createdAt DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt DateTime             @updatedAt @db.Timestamptz(6)
  deletedAt DateTime?            @db.Timestamptz(6)

  // 👤 Minimal audit (UUIDs; Actor relations only for CRITICAL PARENT entities)
  createdByActorId String? @db.Uuid
  updatedByActorId String? @db.Uuid
  deletedByActorId String? @db.Uuid

  // 🧠 Governance
  auditCorrelationId String?                    @db.Uuid
  dataClassification EstimateDataClassification @default(INTERNAL)
  // retentionPolicy    RetentionPolicy?  // descomenta si tu módulo lo usa

  // 🔎 Observability (OPTIONAL: enable only if it adds real value)
  // traceId      String? @db.VarChar(64)
  // spanId       String? @db.VarChar(32)
  // authContext  String? @db.Text
  // hashToken    String? @db.VarChar(255) // add per-tenant index if you query it
  // metadata     Json?   @db.JsonB
  // recordSource String? @db.VarChar(50)  // API, IMPORT, SYSTEM
  // timezone     String? @db.VarChar(50)

  // 🔗 Required relations
  // tenant Tenant @relation("TenantToEstimateRevision", fields: [tenantId], references: [id], onDelete: Cascade)

  // 👥 Actor relations (ENABLE ONLY for CRITICAL PARENT entities)
  // createdByActor Actor? @relation("EstimateRevisionCreatedByActor", fields: [createdByActorId], references: [id], onDelete: SetNull)
  // updatedByActor Actor? @relation("EstimateRevisionUpdatedByActor", fields: [updatedByActorId], references: [id], onDelete: SetNull)
  // deletedByActor Actor? @relation("EstimateRevisionDeletedByActor", fields: [deletedByActorId], references: [id], onDelete: SetNull)

  // Enable ONLY if you use these fields:
  // @@index([tenantId, hashToken])
  // @@index([tenantId, recordSource])
  // @@index([tenantId, timezone])
  // @@index([metadata], type: Gin)

  // 🔗 Relations
  estimate Estimate @relation(fields: [tenantId, estimateId], references: [tenantId, id], onDelete: Cascade)

  // 🗂️ Indexes & constraints (tenant-first)
  @@unique([tenantId, id])
  @@unique([tenantId, estimateId, revisionNumber]) // Unique revision number per estimate
  @@index([tenantId, estimateId])
  @@index([tenantId, status])
  @@index([tenantId, isActive])
  @@index([tenantId, revisionType])
  @@index([tenantId, deletedAt])
  @@index([createdAt], type: Brin)
  @@index([tenantId, auditCorrelationId])
  @@index([tenantId, dataClassification])
  @@index([snapshot], type: Gin) // For JSON queries
  @@map("estimate_revision")
}

model EstimateSection {
  // 🆔 Identity & Tenant
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  // 🔗 Parent estimate relationship
  estimateId String @db.Uuid

  // 📄 Section details
  /// Section name (e.g., "Plumbing", "Electrical", "Materials")
  name             String   @db.VarChar(255)
  /// Optional detailed description of this section
  description      String?  @db.Text
  /// Display order within the estimate
  sortOrder        Int      @default(0)
  /// Section category for grouping (LABOR, MATERIALS, EQUIPMENT, etc.)
  category         String?  @db.VarChar(100)
  /// Whether this section is included in totals calculation
  includeInTotal   Boolean  @default(true)
  /// Optional markup percentage for this section
  markupPercentage Decimal? @db.Decimal(5, 2)

  // 💰 Section financial totals (calculated from line items)
  subtotalAmount Decimal @default(0) @db.Decimal(12, 2)
  markupAmount   Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @default(0) @db.Decimal(12, 2)

  // 📊 Metrics
  lineItemCount Int @default(0)

  // 📊 Lifecycle
  status    EstimateEntityStatus @default(ACTIVE)
  version   Int                  @default(1)
  createdAt DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt DateTime             @updatedAt @db.Timestamptz(6)
  deletedAt DateTime?            @db.Timestamptz(6)

  // 👤 Minimal audit (UUIDs; Actor relations only for CRITICAL PARENT entities)
  createdByActorId String? @db.Uuid
  updatedByActorId String? @db.Uuid
  deletedByActorId String? @db.Uuid

  // 🧠 Governance
  auditCorrelationId String?                    @db.Uuid
  dataClassification EstimateDataClassification @default(INTERNAL)
  // retentionPolicy    RetentionPolicy?  // descomenta si tu módulo lo usa

  // 🔎 Observability (OPTIONAL: enable only if it adds real value)
  // traceId      String? @db.VarChar(64)
  // spanId       String? @db.VarChar(32)
  // authContext  String? @db.Text
  // hashToken    String? @db.VarChar(255) // add per-tenant index if you query it
