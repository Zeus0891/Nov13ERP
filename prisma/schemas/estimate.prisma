  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
  HIGHLY_RESTRICTED

  @@map("data_classification_level")
}

/// Generic active status for child entities (sections, lines, etc.)
enum EstimateEntityStatus {
  ACTIVE // Entity is active and available
  INACTIVE // Entity is inactive but not deleted
  ARCHIVED // Entity is archived for historical purposes
  DELETED // Entity is soft-deleted

  @@map("estimate_entity_status")
}

/// Severity for history / audit events
enum HistoryEventSeverity {
  INFO
  NOTICE
  WARNING
  ERROR
  CRITICAL

  @@map("history_event_severity")
}

/// Origin of the event (for history / audit)
