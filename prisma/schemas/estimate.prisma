  tenantId String @db.Uuid

  // 🔗 Parent estimate relationship
  estimateId String @db.Uuid

  // 🔒 Public link details
  /// Secure token for public access (UUID or secure random string)
  token          String                 @db.VarChar(255)
  /// Public link expiration date
  expiresAt      DateTime?              @db.Timestamptz(6)
  /// Whether link is currently active
  isActive       Boolean                @default(true)
  /// Link type (VIEW_ONLY, APPROVE_DECLINE, FULL_INTERACTION)
  linkType       EstimatePublicLinkType @default(APPROVE_DECLINE)
  /// Password protection (optional)
  accessPassword String?                @db.VarChar(255) // Hashed
  /// Maximum number of views allowed
  maxViews       Int?                   @db.Integer
  /// Current view count
  viewCount      Int                    @default(0)

  // 👥 Client interaction tracking
  /// First view timestamp
  firstViewedAt       DateTime? @db.Timestamptz(6)
  /// Last view timestamp
  lastViewedAt        DateTime? @db.Timestamptz(6)
  /// Client approval timestamp
  clientApprovedAt    DateTime? @db.Timestamptz(6)
  /// Client decline timestamp
  clientDeclinedAt    DateTime? @db.Timestamptz(6)
  /// Client's decision reason/notes
  clientDecisionNotes String?   @db.Text
  /// Client contact information (from form)
  clientName          String?   @db.VarChar(255)
  clientEmail         String?   @db.VarChar(255)
  clientPhone         String?   @db.VarChar(50)

  // 📈 Analytics data
  /// View analytics (IP addresses, timestamps, etc.)
  viewAnalytics        Json? @db.JsonB
  /// Client device/browser information
  deviceInfo           Json? @db.JsonB
  /// Geographic information (if available)
  geoLocation          Json? @db.JsonB
  /// Time spent viewing (seconds)
  totalViewTimeSeconds Int?  @db.Integer

  // ⚙️ Configuration
  /// Whether PDF download is enabled
  allowPdfDownload    Boolean @default(true)
  /// Whether client can request changes
  allowChangeRequests Boolean @default(true)
  /// Custom message to display to client
  customMessage       String? @db.Text
  /// Branding configuration
  brandingConfig      Json?   @db.JsonB

  // 📊 Lifecycle
  status    EstimateEntityStatus @default(ACTIVE)
  version   Int                  @default(1)
  createdAt DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt DateTime             @updatedAt @db.Timestamptz(6)
  deletedAt DateTime?            @db.Timestamptz(6)

  // 👤 Minimal audit (UUIDs; Actor relations only for CRITICAL PARENT entities)
  createdByActorId String? @db.Uuid
  updatedByActorId String? @db.Uuid
  deletedByActorId String? @db.Uuid

  // 🧠 Governance
  auditCorrelationId String?                    @db.Uuid
  dataClassification EstimateDataClassification @default(INTERNAL)
  // retentionPolicy    RetentionPolicy?  // descomenta si tu módulo lo usa

  // 🔎 Observability (OPTIONAL: enable only if it adds real value)
  // traceId      String? @db.VarChar(64)
  // spanId       String? @db.VarChar(32)
  // authContext  String? @db.Text
  // hashToken    String? @db.VarChar(255) // add per-tenant index if you query it
  // metadata     Json?   @db.JsonB
  // recordSource String? @db.VarChar(50)  // API, IMPORT, SYSTEM
  // timezone     String? @db.VarChar(50)

  // 🔗 Required relations
  // tenant Tenant @relation("TenantToEstimatePublicLink", fields: [tenantId], references: [id], onDelete: Cascade)

  // 👥 Actor relations (ENABLE ONLY for CRITICAL PARENT entities)
  // createdByActor Actor? @relation("EstimatePublicLinkCreatedByActor", fields: [createdByActorId], references: [id], onDelete: SetNull)
  // updatedByActor Actor? @relation("EstimatePublicLinkUpdatedByActor", fields: [updatedByActorId], references: [id], onDelete: SetNull)
  // deletedByActor Actor? @relation("EstimatePublicLinkDeletedByActor", fields: [deletedByActorId], references: [id], onDelete: SetNull)

  // Enable ONLY if you use these fields:
  // @@index([tenantId, hashToken])
  // @@index([tenantId, recordSource])
  // @@index([tenantId, timezone])
  // @@index([metadata], type: Gin)

  // 🔗 Relations
  estimate Estimate @relation(fields: [tenantId, estimateId], references: [tenantId, id], onDelete: Cascade)

  // 🗂️ Indexes & constraints (tenant-first)
  @@unique([tenantId, id])
  @@unique([token]) // Global unique token for security
  @@unique([tenantId, estimateId, isActive]) // Only one active link per estimate
  @@index([tenantId, estimateId])
  @@index([tenantId, isActive])
  @@index([tenantId, linkType])
  @@index([expiresAt])
  @@index([tenantId, clientApprovedAt])
  @@index([tenantId, clientDeclinedAt])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@index([createdAt], type: Brin)
  @@index([tenantId, auditCorrelationId])
  @@index([tenantId, dataClassification])
  @@index([viewAnalytics], type: Gin) // For JSON queries
  @@index([deviceInfo], type: Gin) // For JSON queries
  @@index([geoLocation], type: Gin) // For JSON queries
  @@map("estimate_public_link")
}
