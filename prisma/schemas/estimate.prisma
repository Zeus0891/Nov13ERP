// -----------------------------------------------------------
// 📄 Estimate main document
// -----------------------------------------------------------

/// Main estimate lifecycle states
enum EstimateStatus {
  DRAFT // User working on it; not yet sent to customer
  PENDING_INTERNAL_APPROVAL // Submitted to internal approvers
  PENDING_CLIENT_REVIEW // Sent to client, waiting on client
  CLIENT_APPROVED // Client approved via public link or signature
  CLIENT_DECLINED // Client explicitly declined
  INTERNAL_REJECTED // Internal approver rejected
  APPROVED // Both sides satisfied; final internal approval granted
  CONVERTED // Estimate has generated a Project and Invoice
  CANCELED // No longer valid, superseded, or withdrawn
  EXPIRED // Estimate has passed its validity date
  DELETED // Soft-delete flag set; visible only with special filters

  @@map("estimate_status")
}

/// Internal approval states
enum EstimateApprovalStatus {
  NOT_REQUIRED // No internal approval needed
  NOT_SUBMITTED // Approval required, but request not yet created
  PENDING // Waiting for internal approval
  APPROVED // Internally approved
  REJECTED // Internally rejected
  ESCALATED // Escalated according to approval rules
  ON_HOLD // Temporarily paused
  CANCELLED // Approval flow cancelled

  @@map("estimate_approval_status")
}

/// Client decision states
enum EstimateClientStatus {
  PENDING // Client hasn't responded yet
  VIEWED // Client has viewed the estimate at least once
  ACCEPTED // Client accepted/approved
  DECLINED // Client declined/rejected
  EXPIRED // Link or estimate expired before decision
  CANCELED // Flow cancelled (e.g. estimate withdrawn)

  @@map("estimate_client_status")
}

