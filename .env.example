# ================================
# DATABASE CONFIGURATION (NEON)
# ================================
# Get these from your Neon dashboard: https://console.neon.tech
NEON_DATABASE_URL="postgresql://username:password@hostname/database?sslmode=require"
NEON_DIRECT_URL="postgresql://username:password@hostname/database?sslmode=require"

# ================================
# SERVER CONFIGURATION
# ================================
NODE_ENV="development"
PORT=3000
HOST="localhost"

# ================================
# SECURITY & JWT
# ================================
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12

# ================================
# CORS & SECURITY
# ================================
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ================================
# LOGGING
# ================================
LOG_LEVEL="info"
LOG_FORMAT="combined"

# ================================
# EMAIL CONFIGURATION (Optional)
# ================================
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# ================================
# FILE STORAGE (Optional)
# ================================
UPLOAD_PATH="./uploads"
MAX_FILE_SIZE="10485760"