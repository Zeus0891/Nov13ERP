{
    "name": "nov13erp",
    "version": "1.0.0",
    "description": "Enterprise Resource Planning (ERP) Platform - Modern Node.js/TypeScript/Prisma solution",
    "main": "dist/server.js",
    "type": "commonjs",
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
    },
    "scripts": {
        "build": "tsc && tsc-alias",
        "start": "node dist/server.js",
        "dev": "tsx watch src/server.ts",
        "dev:debug": "tsx watch --inspect src/server.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:e2e": "jest --config jest.e2e.config.js",
        "lint": "eslint src/**/*.ts",
        "lint:fix": "eslint src/**/*.ts --fix",
        "format": "prettier --write \"src/**/*.{ts,js,json}\"",
        "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
        "code:fix": "npm run format && npm run lint:fix",
        "workspace:init": "npm run clean && npm install && npm run db:generate && npm run build",
        "db:complete-validation": "npm run db:validate && npm run db:generate",
        "db:generate": "dotenv -e .env -- prisma generate --schema=prisma/schemas/schema.prisma",
        "db:push": "dotenv -e .env -- prisma db push --schema=prisma/schemas/schema.prisma",
        "db:migrate": "dotenv -e .env -- prisma migrate dev --schema=prisma/schemas/schema.prisma",
        "db:migrate:prod": "dotenv -e .env -- prisma migrate deploy --schema=prisma/schemas/schema.prisma",
        "db:studio": "dotenv -e .env -- prisma studio --schema=prisma/schemas/schema.prisma",
        "db:validate": "dotenv -e .env -- prisma validate --schema=prisma/schemas/schema.prisma",
        "db:seed": "tsx src/prisma/seed.ts",
        "db:reset": "dotenv -e .env -- prisma migrate reset --force --schema=prisma/schemas/schema.prisma",
        "copilot:setup": "echo '🤖 GitHub Copilot is configured! Check .vscode/ for settings and snippets.'",
        "postinstall": "prisma generate",
        "clean": "rimraf dist",
        "prepare": "husky install"
    },
    "keywords": [
        "erp",
        "enterprise",
        "nodejs",
        "typescript",
        "express",
        "prisma",
        "postgresql",
        "neon",
        "crm",
        "project-management"
    ],
    "author": "Zeus0891 <flako9108@gmail.com>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Zeus0891/Nov13ERP.git"
    },
    "dependencies": {
        "@prisma/client": "^6.19.0",
        "bcryptjs": "^3.0.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "compression": "^1.8.1",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "express-rate-limit": "^8.2.1",
        "express-validator": "^7.3.0",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.1",
        "prisma": "^6.19.0",
        "reflect-metadata": "^0.2.2",
        "winston": "^3.18.3"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.5",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/node": "^24.10.1",
        "@types/supertest": "^6.0.3",
        "@typescript-eslint/eslint-plugin": "^8.46.4",
        "@typescript-eslint/parser": "^8.46.4",
        "dotenv-cli": "^11.0.0",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "husky": "^9.1.7",
        "jest": "^30.2.0",
        "lint-staged": "^16.2.6",
        "nodemon": "^3.1.11",
        "prettier": "^3.6.2",
        "rimraf": "^6.1.0",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.5",
        "tsc-alias": "^1.8.16",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3"
    }
}
